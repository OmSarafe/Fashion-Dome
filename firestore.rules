rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCustomer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer';
    }

    function canCancelOwnOrder() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && (resource.data.status == 'placed'
          || resource.data.status == 'processing')
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'cancelledBy',
          'cancelledAt',
          'updatedAt'
        ]);
    }

    function hasValidPaymentOnCreate() {
      return (request.resource.data.paymentMethod == 'Cash on delivery'
          && request.resource.data.paymentStatus == 'pending')
        || (request.resource.data.paymentMethod == 'Stripe card payment'
          && request.resource.data.paymentStatus == 'verification_pending'
          && request.resource.data.stripePaymentIntentId is string
          && request.resource.data.stripePaymentIntentId.matches('^pi_[A-Za-z0-9_]+$'));
    }

    function hasValidOrderShape() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'items',
          'subtotalInPence',
          'shippingInPence',
          'totalInPence',
          'deliveryAddress',
          'paymentMethod',
          'paymentStatus',
          'stripePaymentIntentId',
          'status',
          'createdAt'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.subtotalInPence is int
        && request.resource.data.subtotalInPence > 0
        && request.resource.data.shippingInPence == 80
        && request.resource.data.totalInPence
          == request.resource.data.subtotalInPence + 80
        && request.resource.data.deliveryAddress is string
        && request.resource.data.deliveryAddress.size() >= 10
        && request.resource.data.deliveryAddress.size() <= 500
        && request.resource.data.createdAt is timestamp;
    }

    function validCustomerProfileUpdate() {
      let data = request.resource.data;
      let hasLatitude = data.keys().hasAny(['deliveryLatitude']);
      let hasLongitude = data.keys().hasAny(['deliveryLongitude']);
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && data.role == 'customer'
        && data.role == resource.data.role
        && data.createdAt == resource.data.createdAt
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.email is string
        && data.email == request.auth.token.email
        && data.email.size() <= 320
        && (!data.keys().hasAny(['phone'])
          || (data.phone is string && data.phone.size() <= 30))
        && (!data.keys().hasAny(['deliveryAddress'])
          || (data.deliveryAddress is string
            && data.deliveryAddress.size() <= 500))
        && hasLatitude == hasLongitude
        && (!hasLatitude
          || (data.deliveryLatitude is number
            && data.deliveryLongitude is number
            && data.deliveryLatitude >= -90
            && data.deliveryLatitude <= 90
            && data.deliveryLongitude >= -180
            && data.deliveryLongitude <= 180))
        && (!data.keys().hasAny(['gender'])
          || data.gender in [
            'Male',
            'Female',
            'Non-binary',
            'Prefer not to say'
          ])
        && (!data.keys().hasAny(['dateOfBirth'])
          || (data.dateOfBirth is string && data.dateOfBirth.size() == 10))
        && (!data.keys().hasAny(['orderNotificationsEnabled'])
          || data.orderNotificationsEnabled is bool)
        && (!data.keys().hasAny(['marketingNotificationsEnabled'])
          || data.marketingNotificationsEnabled is bool)
        && (!data.keys().hasAny(['fcmTokens'])
          || (data.fcmTokens is list && data.fcmTokens.size() <= 20))
        && (!data.keys().hasAny(['updatedAt'])
          || data.updatedAt is timestamp)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'phone',
          'deliveryAddress',
          'deliveryLatitude',
          'deliveryLongitude',
          'gender',
          'dateOfBirth',
          'orderNotificationsEnabled',
          'marketingNotificationsEnabled',
          'fcmTokens',
          'updatedAt'
        ]);
    }

    function validNewCustomerProfile() {
      return request.resource.data.keys().hasAll([
          'name',
          'email',
          'role',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'role',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 320
        && request.resource.data.role == 'customer'
        && request.resource.data.createdAt is timestamp;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;

      match /reviews/{userId} {
        allow read: if true;
        allow create, update: if false;
        allow delete: if signedIn()
          && request.auth.uid == userId
          && resource.data.userId == request.auth.uid;
      }

      match /stockMovements/{movementId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // Account deletion searches reviews across every product. Keep ordinary
    // review reads public above, while limiting collection-group cleanup to
    // documents owned by the signed-in customer.
    match /{path=**}/reviews/{reviewId} {
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if owns(userId)
        && validNewCustomerProfile();

      allow read: if owns(userId) || isAdmin();

      allow update: if isAdmin()
        || (owns(userId) && validCustomerProfileUpdate());

      allow delete: if isAdmin();

      match /favorites/{productId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.keys().hasOnly(['productId', 'createdAt'])
          && request.resource.data.keys().hasAll(['productId', 'createdAt'])
          && request.resource.data.productId == productId
          && request.resource.data.createdAt is timestamp
          && exists(/databases/$(database)/documents/products/$(productId));
      }

      match /cart/{cartItemId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.keys().hasOnly([
            'productId',
            'size',
            'quantity',
            'updatedAt'
          ])
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.size is string
          && request.resource.data.size.size() > 0
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0
          && request.resource.data.quantity <= 99
          && request.resource.data.updatedAt is timestamp
          && exists(
            /databases/$(database)/documents/products/$(request.resource.data.productId)
          )
          && get(
            /databases/$(database)/documents/products/$(request.resource.data.productId)
          ).data.availableSizes is list
          && request.resource.data.size in get(
            /databases/$(database)/documents/products/$(request.resource.data.productId)
          ).data.availableSizes
          && get(
            /databases/$(database)/documents/products/$(request.resource.data.productId)
          ).data.stock is int
          && request.resource.data.quantity <= get(
            /databases/$(database)/documents/products/$(request.resource.data.productId)
          ).data.stock;
      }
    }

    match /orders/{orderId} {
      allow create: if false;

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update: if isAdmin() || canCancelOwnOrder();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
